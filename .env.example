# Podcast platform links (public)
NEXT_PUBLIC_SPOTIFY_SHOW_URL=https://open.spotify.com/show/...
NEXT_PUBLIC_SPOTIFY_SHOW_ID=...
NEXT_PUBLIC_APPLE_PODCAST_URL=https://podcasts.apple.com/...
NEXT_PUBLIC_APPLE_PODCAST_ID=id...

# Neon Postgres (provisioned via Vercel Marketplace)
DATABASE_URL=postgresql://...

# Vercel Blob (provisioned via Vercel dashboard / CLI)
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Admin auth (password-only login)
# Generate the secret with: openssl rand -base64 32
AUTH_SECRET=...
# Generate with: node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'the-password'
# In .env.local every $ in the hash MUST be escaped as \$ (Next.js expands $VARS in env files).
# In the Vercel dashboard paste the hash raw, without escaping.
ADMIN_PASSWORD_HASH=\$2b\$12\$...
